# Muse Bridge settings. Type the password on this computer only, never in a chat.
GMAIL_ADDRESS=
# 16-letter Gmail app password (myaccount.google.com/apppasswords). Spaces are fine.
GMAIL_APP_PASSWORD=

# --- usually no need to change these ---
MUSE_URL=https://muse.ai
MUSE_CHAT_NAME=Main chat
SUBJECT_TAG=@muse
GMAIL_LABEL=MUSE-HANDLED
MAX_BODY_CHARS=3000
# true = no browser window; set to false to watch it work
HEADLESS=true
BROWSER_CHANNEL=chrome
